<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Referenced in AndroidManifest.xml via android:dataExtractionRules.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive Supabase credentials -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="root" path="prefs/" />

        <!-- Allow backup of non-sensitive app data -->
        <include domain="root" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
